{
	"name": "core-jules-api",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"bunx wrangler dev\" \"cd frontend && bun run dev\"",
		"dev:backend": "bunx wrangler dev",
		"dev:frontend": "cd frontend && bun run dev",
		"build": "echo 'No build step needed for this worker setup'",
		"build:frontend": "cd frontend && bun install && bun run build",
		"drizzle:generate": "bunx drizzle-kit generate",
		"db:migrate:remote": "bunx wrangler d1 migrations apply DB --remote",
		"db:migrate:local": "bunx wrangler d1 migrations apply DB --local",
		"deploy": "npm run check:structure && npm run build:frontend && npm run drizzle:generate && npm run db:migrate:remote && bunx wrangler deploy",
		"deploy:dry-run": "npm run check:structure && npm run build:frontend && npm run drizzle:generate && bunx wrangler deploy --dry-run",
		"tail": "bunx wrangler tail",
		"types": "wrangler types && node scripts/tests/utils/print-env-usage.js",
		"test": "bun test",
		"test:api:local": "scripts/tests/.venv/bin/python scripts/tests/test_comprehensive.py --env local",
		"test:api:deployed": "scripts/tests/.venv/bin/python scripts/tests/test_comprehensive.py --env deployed",
		"test:health": "scripts/tests/.venv/bin/python scripts/tests/test_endpoints.py --health",
		"test:ai-gateway": "scripts/tests/.venv/bin/python scripts/tests/test_ai_gateway.py",
		"check:structure": "bun scripts/tests/utils/check-backend-structure.ts",
		"tree:src": "tree src",
		"tree:frontend": "tree frontend",
		"tree:all": "tree -I 'node_modules|.git|.wrangler|dist|.gemini|coverage|.DS_Store'",
		"latest:health": "node scripts/d1-queries/get_latest_health_record.js"
	},
	"dependencies": {
		"@ai-sdk/google": "^2.0.45",
		"@ai-sdk/openai": "^2.0.80",
		"@cloudflare/agents": "^0.0.16",
		"@google/genai": "^1.32.0",
		"ai": "^5.0.108",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.10.8",
		"openai": "^6.10.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"workers-ai-provider": "^2.0.0",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.17.0",
		"@eslint/js": "^9.33.0",
		"@types/node": "^25.0.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.0.0",
		"drizzle-kit": "^0.31.8",
		"eslint": "^9.33.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.39.1",
		"vite": "^7.1.2",
		"wrangler": "^4.53.0"
	}
}