{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workerd/main/src/workerd/api/config.schema.json",
  "name": "core-jules-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "JULES_BASE_URL": "https://jules.googleapis.com/v1alpha",
    "DEFAULT_GITHUB_OWNER": "jmbish04",
    "LOG_LEVEL": "info"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "core-jules-api",
      "database_id": "949a78b8-10c1-4a1b-85a7-30e010466d61",
      "database_preview_id": "34fbbb70-d0aa-48ef-9d1e-f92059f4c46e",
      "remote": true,
      "migrations_dir": "drizzle"
    },
    {
      "binding": "CORE_GITHUB_API",
      "database_name": "core-github-api",
      "database_id": "55dc4e06349e46bba086a2e347d5e291",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDO"
      },
      {
        "name": "ROOM_DO",
        "class_name": "RoomDO"
      },
      {
        "name": "SESSION_ACTOR",
        "class_name": "SessionActor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SessionActor"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ETAG_KV",
      "id": "55dc4e06349e46bba086a2e347d5e291"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JULES_QUEUE",
        "queue": "jules-queue"
      },
      {
        "binding": "STATUS_QUEUE",
        "queue": "status-queue"
      },
      {
        "binding": "AGENT_QUEUE",
        "queue": "jules-orchestrator-queue"
      }
    ],
    "consumers": [
      {
        "queue": "jules-orchestrator-queue",
        "max_batch_size": 5,
        "max_retries": 3
      }
    ]
  },
  "services": [
    {
      "binding": "GITHUB",
      "service": "core-github-api"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 0 * * *"
    ]
  }
}